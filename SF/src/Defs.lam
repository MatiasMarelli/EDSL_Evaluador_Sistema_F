
def Nat := 4 N . ((N -> N) -> N -> N)
def List X := 4 R . ((X -> R -> R) -> R -> R)

def nil :: 4 X.List X
def nil = /\ X./\R. \c: X -> Y -> Y. \n:Y. n

def cons :: 4 X. X -> List X -> List X
def cons = /\X . \x:X. \xs: List X. /\Y. \c:X -> Y -> Y. \n:Y. c x ((xs <Y>) c n)

def zero :: Nat
def zero = /\ X. \s: X->X. \z:X.z

def suc :: Nat->Nat
def suc = \n:Nat. /\X. \s:X -> X.\z:X. s((n <X>)s z)

def length :: 4 X. List X -> Nat 
def length = /\ X. \xs:List X. (xs <Nat>) (\x:X.\r:Nat.(suc r)) (zero <Nat>)

def udt :: List Nat
def udt = (cons <Nat>) (suc (suc (suc (zero <Nat>)))) ((cons <Nat>) (suc (suc (zero <Nat>))) ((cons <Nat> )(suc (zero <Nat>)) (nil <Nat>)))

def alenNat :: Nat
def alenNat = (length <Nat>) udt

def tres :: Nat
def tres = suc(suc (suc (zero <Nat>)))

def uno :: Nat
def uno = suc (zero <Nat>)

def z :: Nat
def z = zero <Nat>

def cinco :: Nat
def cinco = suc(suc(suc(suc (suc (zero <Nat>)))))

def listcinco :: List Nat
def listcinco = (cons <Nat>) (suc(zero <Nat>)) ((cons <Nat>) (zero <Nat>) ((cons <Nat>) (zero <Nat>) ((cons <Nat>) (zero <Nat>) ((cons <Nat>) (zero <Nat>) (nil <Nat>)))))


def lencinco :: Nat
def lencinco = (length <Nat>) listcinco


def Bool := 4 B. B -> B -> B

def true  :: Bool
def true  = /\X. \t:X. \f:X . t

def false :: Bool
def false = /\X. \t:X. \f:X . f

def if :: 4 X. Bool -> X -> X -> X 
def if = /\X. \b:Bool . \e:X . \ee:X . (b <X>) e ee 

def lenat :: List Nat -> Nat
def lenat = length <Nat>

def consnat :: Nat -> List Nat -> Nat
def consnat = \x:Nat. \y:List Nat .((cons <Nat>) x y) <Nat>

def test :: Nat
def test = (\b:Bool. ((if <Nat>) b) (suc (zero <Nat>)) (zero <Nat>)) false 